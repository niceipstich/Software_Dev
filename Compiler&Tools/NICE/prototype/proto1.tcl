module mod1 {
    Interface ifce1 {
        port a -direction input -width 4
        port b -direction output -width 4
    }
}

module mod2 {
    Interface ifce2 {
        port b -direction output -width 4
        port a -direction input -width 4        
    }
    Interface ifce3 {
        port c -direction output -width 4  -default 0x0
    }
}

module Design {
    # This is explicit initialization of the interface, 
    # which is generated by tool is not defined explicitly.
    Interface ifce3 {
        port c -direction output -width 4  -default 0x0
    }

    # Instance declaration. 
    instance mod1 A {
        # connectivity is defined in the instance level, which is not generated 
        # by tool and defined explicitly.
        connectivity {
            connect ifce1 ifce2 -net
        }
    }

    instance mod2 B {
        connectivity {
            connect ifce1 ifce2 -net
            connect ifce3 -expose_as
        }
    }
}